# ===== 核心 =====
MONGODB_URI=mongodb://localhost:27017/url-saver
PORT=4000
API_URL=http://localhost:4000/api/urls

# ===== 認證 / 授權（皆為必要）=====
# Google OAuth（前端登入）
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# 簽發 JWT 用的密鑰，請使用夠長的隨機字串
JWT_SECRET=your_long_random_secret
# 允許登入的 email（逗號分隔）。未設定時所有登入都會被拒絕（fail-closed）
ALLOWED_EMAILS=you@example.com

# ===== CORS =====
# 允許的前端來源（逗號分隔）。未設定時對所有來源開放，正式環境務必設定
ALLOWED_ORIGINS=http://localhost:5173

# ===== Telegram bot =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# bot 與後端溝通用的內部 API key（請使用隨機字串）
INTERNAL_API_KEY=your_internal_api_key
# 允許使用 bot 的 Telegram 使用者（ID 或 username，逗號分隔）
TELEGRAM_ALLOWED_USERS=your_telegram_user_id
# bot 存入的連結歸屬的 email；未設定時取 ALLOWED_EMAILS 第一個
BOT_OWNER_EMAIL=you@example.com

# ===== AWS S3（預覽圖上傳）=====
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=linkeeper

# ===== YouTube Data API（選用，用於更準確的 YouTube metadata）=====
YOUTUBE_API_KEY=your_youtube_api_key
